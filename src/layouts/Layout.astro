---
import '../styles/global.css';

import '@fontsource/fraunces/500-italic.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;

  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title = 'kloseup: Zoho-Beratung & Integration | Christopher Klose',
  description = 'Zoho-Beratung und Integration für kleine und mittlere Unternehmen in Salzburg und der Grenzregion.',
  noindex = false,

  ogTitle,
  ogDescription,
  ogImage = 'https://kloseup.eu/logos/og-default.jpg'
} = Astro.props;

const siteUrl = 'https://kloseup.eu';
let path = Astro.url.pathname;
if (path !== '/' && !path.endsWith('/')) {
  path += '/';
}
const canonicalUrl = new URL(path, Astro.site);

// Schema.org LocalBusiness Data
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "kloseup",
  "description": "Zoho-Beratung & Integration für KMU in Salzburg",
  "url": `${siteUrl}`,
  "telephone": "+43-660-3612354",
  "email": "christopher@kloseup.eu",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Salzburg",
    "addressRegion": "Salzburg",
    "addressCountry": "AT"
  },
  "areaServed": [
    {"@type": "City", "name": "Salzburg"},
    {"@type": "State", "name": "Salzburg"},
    {"@type": "AdministrativeArea", "name": "Bayerisches Grenzgebiet"}
  ],
  "founder": {
    "@type": "Person",
    "name": "Christopher Klose"
  },
  "knowsAbout": [
    "Zoho CRM",
    "Zoho Bigin",
    "Zoho Analytics",
    "Zoho Calendar",
    "Zoho Meet",
    "Zoho Books",
    "Zoho Inventory",
    "CRM Einrichtung",
    "Digitalisierung",
    "Change Management",
    "Prozessautomatisierung",
    "KMU Beratung"
  ],
  "priceRange": "€€",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  }
};
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="description" content={description} />
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDescription || description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="kloseup.eu, Zoho Beratung Salzburg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle || title} />
  <meta name="twitter:description" content={ogDescription || description} />
  <link rel="canonical" href={canonicalUrl} />
  <title>{title}</title>
  <link rel="icon" href="/logos/favicon_144_kloseup.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/logos/favicon_144_kloseup.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/logos/apple-touch-icon_kloseup.png" />
  
  <!-- Schema.org Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
