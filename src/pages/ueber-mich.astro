---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout
  title="Über mich | Christopher Klose | Klosestral"
  description="Berater für pragmatische Digitalisierung & Zoho-Lösungen. Ich helfe Unternehmen, ihre Prozesse ins Jahr 2026 zu bringen ohne teure Fehlinvestitionen."
>
  <Header />

  <main id="top">
    <!-- Hero Section -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <h1>Christopher Klose</h1>
          <p class="lede">Berater für pragmatische Digitalisierung & Zoho-Lösungen</p>
          <p class="hero-sub">Salzburg, Österreich</p>
          <div class="hero-actions">
            <a href="mailto:christopher@kloseup.eu" class="btn">
              <span class="btn-text">Per Mail</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <a href="https://wa.me/436641234567" class="btn">
              <span class="btn-text">Per WhatsApp</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="hero-image" style="justify-self: center;">
          <div class="hero-image-wrap">
            <img src={`${baseUrl}images/1731027398052.jpeg`} alt="Christopher Klose" class="hero-image-img" />
          </div>
        </div>
      </div>
    </section>

    <!-- Problem Section -->
    <section id="problem">
      <div class="wrap">
        <p class="eyebrow">Sie kennen das</p>
        <h2>Digitalisierung die niemand nutzt</h2>
        <div class="ds-grid">
          <div class="ds-column ds-column--problem">
            <div class="ds-column-header">
              <h3 class="ds-column-title">Das Problem</h3>
            </div>
            <ul class="ds-list">
              <li class="ds-item">
                <p class="ds-item-lead">Teure Tools werden eingeführt und dann ignoriert.</p>
                <p class="ds-item-desc">Lizenzen laufen, aber niemand nutzt sie wirklich.</p>
              </li>
              <li class="ds-item">
                <p class="ds-item-lead">Mitarbeiter arbeiten weiter mit Excel &amp; Outlook.</p>
                <p class="ds-item-desc">Neue CRM- oder ERP-Systeme laufen ungenutzt im Hintergrund.</p>
              </li>
              <li class="ds-item">
                <p class="ds-item-lead">Jeden Monat Geld verschwendet.</p>
                <p class="ds-item-desc">Für Lizenzen Schulungen und Support ohne messbaren Nutzen.</p>
              </li>
            </ul>
          </div>
          <div class="ds-column ds-column--reason">
            <div class="ds-column-header">
              <h3 class="ds-column-title">Warum?</h3>
            </div>
            <ul class="ds-list">
              <li class="ds-item">
                <p class="ds-item-lead">Weil die meisten Berater Tools verkaufen, statt Prozesse zu verstehen.</p>
                <p class="ds-item-desc">Der Fokus liegt auf dem Verkauf, nicht auf Ihrer unternehmerischen Herausforderung.</p>
              </li>
              <li class="ds-item">
                <p class="ds-item-lead">Weil Change Management oft nur ein Buzzword ist.</p>
                <p class="ds-item-desc">Nicht der Schlüssel zum Erfolg den es sein sollte.</p>
              </li>
              <li class="ds-item">
                <p class="ds-item-lead">Weil nicht jedes "revolutionäre" Produkt zu Ihrem Business passt.</p>
                <p class="ds-item-desc">Hype ist kein Ersatz für passgenaue Lösungen.</p>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Lösung Section -->
    <section id="loesung" class="loesung">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Meine Lösung</p>
          <h2>Digitalisierung die wirklich funktioniert</h2>
        </div>
        <div class="loesung-intro">
          <p class="loesung-intro-lead">Ich mache Digitalisierung pragmatisch, kosteneffizient und nutzerfreundlich.</p>
          <p class="loesung-intro-sub">Mit mehreren Jahren Erfahrung im Full Cycle Sales und als CRM-Admin (Zoho Bigin, CRM, Books, Inventory) weiß ich:</p>
        </div>
        <div class="loesung-principles">
          <article class="loesung-card">
            <div class="loesung-card-num" aria-hidden="true">01</div>
            <h3 class="loesung-card-title">Prozesse stehen vor Tools</h3>
            <p class="loesung-card-desc">Erst wenn wir verstehen, wie Sie arbeiten, finden wir die richtige Lösung.</p>
          </article>
          <article class="loesung-card">
            <div class="loesung-card-num" aria-hidden="true">02</div>
            <h3 class="loesung-card-title">Change Management ist der Schlüssel</h3>
            <p class="loesung-card-desc">Die beste Software nützt nichts, wenn Ihre Mitarbeiter sie nicht annehmen.</p>
          </article>
          <article class="loesung-card">
            <div class="loesung-card-num" aria-hidden="true">03</div>
            <h3 class="loesung-card-title">Kosten/Nutzen im Fokus</h3>
            <p class="loesung-card-desc">Ich empfehle nur Tools, die messbaren Mehrwert bringen – nicht die neueste Hype-Software.</p>
          </article>
        </div>
        <div class="loesung-ansatz">
          <h2>Mein Ansatz</h2>
          <ol class="loesung-steps">
            <li class="loesung-step">
              <div class="loesung-step-marker" aria-hidden="true"><span class="loesung-step-dot"></span></div>
              <div class="loesung-step-body">
                <h4 class="loesung-step-title">Analyse</h4>
                <p class="loesung-step-desc">Wo hakt es in Ihren Prozessen?</p>
              </div>
            </li>
            <li class="loesung-step">
              <div class="loesung-step-marker" aria-hidden="true"><span class="loesung-step-dot"></span></div>
              <div class="loesung-step-body">
                <h4 class="loesung-step-title">Evaluierung</h4>
                <p class="loesung-step-desc">Welche Tools passen wirklich zu Ihrem Business?</p>
              </div>
            </li>
            <li class="loesung-step">
              <div class="loesung-step-marker" aria-hidden="true"><span class="loesung-step-dot"></span></div>
              <div class="loesung-step-body">
                <h4 class="loesung-step-title">Umsetzung</h4>
                <p class="loesung-step-desc">Schrittweise Einführung – ohne Chaos, ohne Überforderung.</p>
              </div>
            </li>
            <li class="loesung-step">
              <div class="loesung-step-marker" aria-hidden="true"><span class="loesung-step-dot"></span></div>
              <div class="loesung-step-body">
                <h4 class="loesung-step-title">Optimierung</h4>
                <p class="loesung-step-desc">Kontinuierliche Anpassung, damit die Lösung nachhaltig funktioniert.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Warum ich Section -->
    <section id="warum">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Warum ich?</p>
          <h2>Weil ich Ihre Sprache spreche</h2>
        </div>
        <div class="warum-table">
          <div class="warum-row warum-row--head">
            <div class="warum-cell warum-cell--label">Ihre Herausforderung</div>
            <div class="warum-cell warum-cell--label">Meine Lösung</div>
          </div>
          <div class="warum-row">
            <div class="warum-cell warum-cell--frage">"Wir haben zu viele Tools die keiner nutzt."</div>
            <div class="warum-cell warum-cell--antwort">Ich vereinfache Ihre Digital-Landschaft und schaffe Klärung.</div>
          </div>
          <div class="warum-row">
            <div class="warum-cell warum-cell--frage">"Meine Mitarbeiter wehren sich gegen Veränderungen."</div>
            <div class="warum-cell warum-cell--antwort">Ich sorge für Akzeptanz durch Schulungen die praktisch und verständlich sind.</div>
          </div>
          <div class="warum-row">
            <div class="warum-cell warum-cell--frage">"Ich will keine teuren Experimente."</div>
            <div class="warum-cell warum-cell--antwort">Ich setze auf bewährte Lösungen (wie Zoho) mit transparenter Kosten/Nutzen-Analyse.</div>
          </div>
          <div class="warum-row">
            <div class="warum-cell warum-cell--frage">"Unsere Prozesse sind zu komplex."</div>
            <div class="warum-cell warum-cell--antwort">Ich standardisiere und automatisiere wo es Sinn macht.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Versprechen Section -->
    <section id="versprechen">
      <div class="wrap" style="text-align: center;">
        <p class="eyebrow">Mein Versprechen</p>
        <h2 class="versprechen-head">"Kein Bullshit-Bingo. Keine teuren Fehlinvestitionen. Nur Lösungen die in Ihrem Alltag ankommen."</h2>
      </div>
    </section>

    <!-- Weg Section -->
    <section id="weg">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Mein Weg</p>
          <h2>Vom ERP-Fluch zum pragmatischen Berater</h2>
        </div>
        <p class="weg-text">18 Jahre. So lange lief dasselbe System im Unternehmen, in dem ich arbeitete. 18 Jahre dieseligen Workarounds, dieselben Excel-Listen, die niemand hinterfragte.</p>
        <p class="weg-text">Ich sah jeden Tag, wie Mitarbeiter an Prozessen scheiterten, die eigentlich helfen sollten. Nicht die Technik war das Problem. Die Technik funktionierte. Das Problem war, dass niemand die Menschen mitgenommen hatte.</p>
        <p class="weg-text">Also fing ich an, Prozesse umzudenken, Tools zu testen und Lösungen zu bauen, die Menschen tatsächlich nutzen. Keine Pilotprojekte, die nach drei Monaten im Sande verlaufen. Sondern Lösungen, die im Alltag ankommen.</p>
        <p class="weg-text">Heute mache ich genau das für Mittelständler: Digitalisierung, die Ihre Mitarbeiter annehmen, weil sie ihnen wirklich hilft.</p>
      </div>
    </section>

    <!-- Kontakt Section -->
    <section id="kontakt">
      <div class="wrap">
        <div class="kontakt-layout">
          <div class="kontakt-text">
            <p class="eyebrow">Bereit für den nächsten Schritt?</p>
            <h2>Kontaktieren Sie mich</h2>
            <p class="kontakt-intro">Sie wollen Digitalisierung die Ihre Mitarbeiter nutzen und die Ihnen Geld spart?</p>
          </div>
          <div class="kontakt-actions">
            <a href="mailto:christopher@kloseup.eu" class="btn"><span class="btn-text">Per Mail</span><span class="btn-arrow" aria-hidden="true">→</span></a>
            <a href="https://wa.me/436641234567" class="btn"><span class="btn-text">Per WhatsApp</span><span class="btn-arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Privat Section -->
    <section id="privat">
      <div class="wrap">
        <p class="eyebrow">Privat</p>
        <h2>Abseits der Arbeit</h2>
        <p class="privat-text">Abseits der Digitalisierung liebe ich gute Geschichten – ob in Filmen, Serien oder beim Kochen für Freunde. Salzburgs Kaffeehauskultur gibt mir dabei die perfekte Inspiration für neue Ideen.</p>
      </div>
    </section>

    <!-- Quote Section -->
    <section id="quote">
      <div class="wrap">
        <div class="quote-wrap">
          <div class="quote-card">
            <p class="quote-amount">"Luck is when preparation meets opportunity."</p>
            <cite class="quote-label">Seneca</cite>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Hero */
  .hero { padding: 96px 0 72px; }
  .hero-grid { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
  .hero h1 { font-family: 'Fraunces', serif; font-size: clamp(42px, 6vw, 68px); font-weight: 600; color: var(--green-deep); margin: 0 0 12px; line-height: 1.15; }
  .hero .lede { font-size: 20px; color: var(--ink-soft); margin: 0 0 8px; line-height: 1.45; }
  .hero-sub { color: var(--ink-soft); font-size: 15px; margin: 0; }
  .hero-actions { display: flex; gap: 16px; margin-top: 20px; flex-wrap: wrap; }
  .hero-actions .btn { width: 250px; }
  .hero-image-wrap { position: relative; padding: 6px; background: linear-gradient(135deg, var(--green-bright) 0%, var(--green-deep) 100%); border-radius: 50%; width: 207px; height: 207px; }
  .hero-image-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }

  /* Problem */
  #problem { padding: 50px 0; border-top: 1px solid var(--line); }
  .ds-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem; }
  @media (max-width: 768px) { .ds-grid { grid-template-columns: 1fr; } }
  .ds-column { border-radius: 2px; padding: 2rem; border: 1px solid var(--line); background: var(--paper); transition: border-color 0.15s; }
  .ds-column:hover { border-color: var(--green-bright); }
  .ds-column-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .ds-column-title { font-family: 'Fraunces', serif; font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--ink); }
  .ds-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .ds-item { position: relative; padding-left: 1.5rem; }
  .ds-item::before { content: ''; position: absolute; left: 0; top: 0.55rem; width: 8px; height: 8px; border-radius: 50%; }
  .ds-column--problem .ds-item::before { background: #c0392b; }
  .ds-column--reason .ds-item::before { background: var(--green-bright); }
  .ds-item-lead { font-weight: 600; color: var(--ink); margin: 0 0 0.25rem 0; line-height: 1.45; }
  .ds-item-desc { font-size: 0.92rem; color: var(--ink-soft); margin: 0; line-height: 1.45; }
  @media (prefers-reduced-motion: no-preference) {
    .ds-column { opacity: 0; transform: translateY(20px); animation: ds-fade-in 0.6s ease forwards; }
    .ds-column--problem { animation-delay: 0.1s; }
    .ds-column--reason { animation-delay: 0.25s; }
    @keyframes ds-fade-in { to { opacity: 1; transform: translateY(0); } }
  }

  /* Lösung */
  .loesung { padding: 50px 0; border-top: 1px solid var(--line); }
  .section-head { margin-bottom: 40px; }
  .loesung-intro { max-width: 640px; margin-bottom: 48px; }
  .loesung-intro-lead { font-size: 19px; line-height: 1.55; color: var(--ink); margin: 0 0 16px; font-weight: 500; }
  .loesung-intro-sub { font-size: 17px; line-height: 1.6; color: var(--ink-soft); margin: 0; }
  .loesung-principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-bottom: 56px; border: 1px solid var(--line); border-radius: 2px; background: var(--paper); overflow: hidden; }
  .loesung-card { padding: 32px 26px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; transition: background 0.15s; }
  .loesung-card:last-child { border-right: none; }
  .loesung-card:hover { background: var(--bg-alt); }
  .loesung-card-num { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--green-bright); margin-bottom: 6px; }
  .loesung-card-title { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.25; }
  .loesung-card-desc { font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 0; }
  .loesung-ansatz { border-top: 1px solid var(--line); padding-top: 40px; }
  .loesung-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; counter-reset: step; }
  .loesung-step { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 0 20px 0 0; position: relative; }
  .loesung-step:not(:last-child)::after { content: ""; position: absolute; top: 5px; left: calc(100% - 20px); width: 20px; height: 1px; background: var(--line); }
  .loesung-step-marker { display: flex; align-items: center; justify-content: center; width: 12px; height: 12px; }
  .loesung-step-dot { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--green-bright); background: var(--paper); transition: background 0.15s, border-color 0.15s; }
  .loesung-step:hover .loesung-step-dot { background: var(--green-bright); }
  .loesung-step-body { display: flex; flex-direction: column; gap: 4px; }
  .loesung-step-title { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 600; color: var(--green-deep); margin: 0; }
  .loesung-step-desc { font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); margin: 0; }

  /* Warum ich */
  #warum { padding: 50px 0; border-top: 1px solid var(--line); }
  .warum-table { margin-top: 24px; }
  .warum-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .warum-row--head { border-bottom: 2px solid var(--line); }
  .warum-cell--label { font-weight: 600; color: var(--ink); }
  .warum-cell--frage { color: var(--ink-soft); }
  .warum-cell--antwort { color: var(--ink); }
  @media (max-width: 680px) {
    .warum-row { grid-template-columns: 1fr; gap: 6px; padding: 16px 0; }
    .warum-row--head { display: none; }
    .warum-cell--frage::before { content: "Herausforderung"; display: block; font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-bright); margin-bottom: 4px; }
    .warum-cell--antwort::before { content: "Meine Lösung"; display: block; font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-bright); margin-bottom: 4px; }
  }

  /* Versprechen */
  #versprechen { padding: 50px 0; border-top: 1px solid var(--line); }
  .versprechen-head { font-size: clamp(1.25rem, 3.5vw, 1.75rem); max-width: 720px; margin: 0 auto; line-height: 1.4; }

  /* Weg */
  #weg { padding: 50px 0; border-top: 1px solid var(--line); }
  .weg-text { color: var(--ink-soft); line-height: 1.8; }
  .weg-text + .weg-text { margin-top: 16px; }

  /* Kontakt */
  #kontakt { padding: 50px 0; border-top: 1px solid var(--line); }
  .kontakt-layout { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; flex-wrap: wrap; }
  .kontakt-text { flex: 1; min-width: 280px; }
  .kontakt-intro { margin-top: 16px; color: var(--ink-soft); line-height: 1.6; }
  .kontakt-actions { display: flex; flex-direction: column; gap: 16px; }

  /* Privat */
  #privat { padding: 50px 0; border-top: 1px solid var(--line); }
  .privat-text { max-width: 600px; color: var(--ink-soft); line-height: 1.8; }

  /* Quote */
  #quote { padding: 50px 0; border-top: 1px solid var(--line); }
  .quote-wrap { max-width: 600px; margin: 0 auto; }
  .quote-card { text-align: center; transition: background 0.15s; background: var(--paper); border: 1px solid var(--line); border-radius: 2px; padding: 32px; }
  .quote-card:hover { background: var(--bg-alt); }
  .quote-amount { font-size: 1.25rem; font-weight: 400; color: var(--ink); margin: 0 0 8px; line-height: 1.4; }
  .quote-label { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--green-bright); text-transform: uppercase; }

  /* Responsive */
  @media (max-width: 880px) {
    .loesung-principles { grid-template-columns: 1fr; }
    .loesung-card { border-right: none; border-bottom: 1px solid var(--line); }
    .loesung-card:last-child { border-bottom: none; }
    .loesung-steps { grid-template-columns: repeat(2, 1fr); gap: 28px 0; }
    .loesung-step:nth-child(2n)::after { display: none; }
    .kontakt-layout { flex-direction: column; gap: 28px; }
    .kontakt-text { min-width: 0; }
    .kontakt-actions .btn { width: 100%; }
  }
  @media (max-width: 680px) {
    .hero-actions { flex-direction: column; gap: 12px; }
    .hero-actions .btn { width: 100%; }
    .kontakt-layout { flex-direction: column; gap: 28px; }
    .kontakt-text { min-width: 0; }
  }
  @media (max-width: 560px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-image-wrap { width: 160px; height: 160px; margin: 0 auto; }
    .loesung-steps { grid-template-columns: 1fr; gap: 24px; }
    .loesung-step:not(:last-child)::after { display: none; }
    .weg-text { line-height: 1.65; }
  }
</style>
