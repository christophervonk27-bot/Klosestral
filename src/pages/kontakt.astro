---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import PageHero from '../components/PageHero.astro';

const baseUrl = import.meta.env.BASE_URL;

// FAQ Schema.org Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kostet das Erstgespräch etwas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. Das Erstgespräch ist kostenlos und unverbindlich. Wir klären gemeinsam, ob und wie ich Ihnen helfen kann. Passt es nicht, sage ich das ehrlich."
      }
    },
    {
      "@type": "Question",
      "name": "Arbeiten Sie auch außerhalb von Salzburg?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Ich arbeite remote mit Kunden in ganz Österreich und Deutschland. Vor-Ort-Termine sind im Raum Salzburg und im bayerischen Grenzgebiet möglich."
      }
    },
    {
      "@type": "Question",
      "name": "Welche Zoho-Produkte decken Sie ab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zoho Bigin, Zoho CRM, Zoho Analytics, Zoho Calendar, Zoho Meet, Zoho Books und Zoho Inventory. Wenn Sie ein anderes Zoho-Modul brauchen, fragen Sie einfach."
      }
    },
    {
      "@type": "Question",
      "name": "Können Sie auch KI und Automatisierungen einrichten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Ich führe KI-Werkzeuge wie Mistral, Claude oder ChatGPT in Ihrem Team ein, mit Ihren echten Arbeitsbeispielen statt mit Demo-Daten. Abläufe verbinde ich über APIs und Skripte, etwa Monatsreports, die sich selbst erstellen, oder einen internen KI-Assistenten, der verstreutes Unternehmenswissen zentral verfügbar macht. Vor jedem Einsatz gilt aber die Frage: Hilft das hier wirklich? Wenn eine einfachere Lösung reicht, sage ich Ihnen das."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet eine Zoho-Implementierung?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Das hängt vom Umfang ab. Beratung ab 95 € pro Stunde, ein Angebots-Setup ab 650 € projektmäßig, dazu Zoho-Lizenzen ab etwa 7 € pro Nutzer und Monat. Ein finales Angebot erhalten Sie nach dem Erstgespräch."
      }
    },
    {
      "@type": "Question",
      "name": "Wie läuft die Zusammenarbeit ab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Klar strukturiert: Erstgespräch, dann eine schriftliche Empfehlung mit klarem Preis und Umfang, dann die Umsetzung inklusive Einweisung Ihres Teams. Sie wissen jederzeit, was als Nächstes passiert. Nach dem Projekt bin ich für Rückfragen erreichbar."
      }
    },
    {
      "@type": "Question",
      "name": "Wo werden meine Daten gespeichert?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In der EU. Zoho betreibt Rechenzentren in Amsterdam und Dublin, und ich richte Kundenkonten standardmäßig mit EU-Hosting ein. Die Auftragsverarbeitung mit Zoho ist über dessen Datenschutzvereinbarung geregelt. Was für Ihren Fall relevant ist, klären wir im Erstgespräch."
      }
    },
    {
      "@type": "Question",
      "name": "Wir arbeiten noch mit Excel und Outlook. Lohnt sich Zoho trotzdem?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Das klären wir im Erstgespräch. Wenn Ihre Abläufe mit Excel und Outlook sauber laufen, sage ich Ihnen das offen. Ein System wie Zoho Bigin wird interessant, sobald mehrere Personen an denselben Kundendaten arbeiten oder Kundenanfragen durchrutschen. Ob das bei Ihnen schon der Fall ist, prüfen wir gemeinsam, ehe Sie einen Euro ausgeben."
      }
    }
  ]
};
---

<Layout
  title="Kontakt & kostenloses Erstgespräch | kloseup.eu"
  description="Kostenloses Erstgespräch mit Christopher Klose, Zoho-Berater in Salzburg. Schreiben Sie mir, ich melde mich innerhalb von 24 Stunden zurück."
>
  <Header />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main id="top">

    <PageHero
      eyebrow="Kontakt"
      titel="Kostenloses Erstgespräch in Salzburg"
      titelEm="für Ihren Betrieb."
      lede="Erzählen Sie mir kurz, wie heute Anfragen, Angebote und Nachfassen bei Ihnen laufen. Ich sage Ihnen ehrlich, ob und wie Zoho hilft — und wenn nicht, sage ich Ihnen das auch."
    />

    <!-- Formular Section -->
    <section id="kontakt-formular" class="kontakt-section">
      <div class="wrap">
        <div class="kontakt-section-head">
          <p class="eyebrow">Schreiben Sie mir</p>
          <h2>Erzählen Sie mir, worum es geht.</h2>
          <p class="kontakt-intro">
            Je genauer Sie beschreiben, wobei ich Sie unterstützen kann,
            desto gezielter kann ich antworten. Ich melde mich innerhalb
            von 24 Stunden.
          </p>
        </div>
        <ContactForm />
      </div>
    </section>

    <!-- Info-Strip: 3 Karten nebeneinander -->
    <section id="kontakt-info" class="kontakt-info-strip">
      <div class="wrap">
        <div class="info-strip-grid">

          <!-- Karte 1: Direkter Draht -->
          <div class="info-card">
            <p class="eyebrow">Direkt</p>
            <h3 class="info-card-title">Lieber direkt schreiben?</h3>
            <p class="info-card-text">
              Wählen Sie Ihren Weg. Beide landen direkt bei mir.
            </p>
            <div class="info-card-actions">
              <a href="mailto:christopher@kloseup.eu" class="btn info-card-btn">
                <span class="btn-text">Per E-Mail</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a href="https://wa.me/436603612354" class="btn info-card-btn">
                <span class="btn-text">Per WhatsApp</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <!-- Karte 2: Wann & Wo -->
          <div class="info-card">
            <p class="eyebrow">Wann &amp; Wo</p>
            <h3 class="info-card-title">Was Sie wissen sollten</h3>
            <ul class="info-card-list">
              <li>
                <span class="info-card-label">Antwortzeit</span>
                <span class="info-card-value">Innerhalb von 24 Stunden</span>
              </li>
              <li>
                <span class="info-card-label">Standort</span>
                <span class="info-card-value">Salzburg, Österreich</span>
              </li>
              <li>
                <span class="info-card-label">Einsatzgebiet</span>
                <span class="info-card-value">Salzburg &amp; bayerisches Grenzgebiet</span>
              </li>
              <li>
                <span class="info-card-label">Erstgespräch</span>
                <span class="info-card-value">Kostenlos &amp; unverbindlich</span>
              </li>
            </ul>
          </div>

          <!-- Karte 3: Transparente Kosten -->
          <div class="info-card info-card--accent">
            <p class="eyebrow">Transparent</p>
            <h3 class="info-card-title">Keine versteckten Kosten</h3>
            <p class="info-card-text">
              Angebots-Setup ab 650 € einmalig, Zoho-Lizenzen ab ca. 7 €
              pro Nutzer/Monat. Was Förderungen angeht, bin ich ehrlich:
              Die früher beworbenen Programme sind derzeit ausgelaufen
              bzw. pausiert — ich melde mich, wenn es wieder etwas gibt.
            </p>
            <a href="#kontakt-formular" class="btn btn-ghost info-card-btn">
              <span class="btn-text">Kosten klären</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="kontakt-faq">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Häufige Fragen</p>
          <h2>Bevor Sie schreiben.</h2>
        </div>
        <div class="faq-list">
          <details class="faq-item">
            <summary>Kostet das Erstgespräch etwas?</summary>
            <div class="faq-answer">
              <p>Nein. Das Erstgespräch ist kostenlos und unverbindlich. Wir klären gemeinsam, ob und wie ich Ihnen helfen kann. Passt es nicht, sage ich das ehrlich.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Arbeiten Sie auch außerhalb von Salzburg?</summary>
            <div class="faq-answer">
              <p>Ja. Ich arbeite remote mit Kunden in ganz Österreich und Deutschland. Vor-Ort-Termine sind im Raum Salzburg und im bayerischen Grenzgebiet möglich.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Welche Zoho-Produkte decken Sie ab?</summary>
            <div class="faq-answer">
              <p>Zoho Bigin, Zoho CRM, Zoho Analytics, Zoho Calendar, Zoho Meet, Zoho Books und Zoho Inventory. Wenn Sie ein anderes Zoho-Modul brauchen, fragen Sie einfach.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Können Sie auch KI und Automatisierungen einrichten?</summary>
            <div class="faq-answer">
              <p>Ja. Ich biete Expertise für KI-Werkzeuge wie Mistral, Claude oder ChatGPT an, mit Ihren echten Arbeitsbeispielen statt mit Demo-Daten. Abläufe verbinde ich über APIs und Skripte, etwa Monatsreports, die sich selbst erstellen, oder einen internen KI-Assistenten, der verstreutes Unternehmenswissen zentral verfügbar macht. Vor jedem Einsatz gilt aber die Frage: Hilft das hier wirklich? Wenn eine einfachere Lösung reicht, sage ich Ihnen das.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Was kostet eine Zoho-Implementierung?</summary>
            <div class="faq-answer">
              <p>Das hängt vom Umfang ab. Beratung ab 95 € pro Stunde, ein Angebots-Setup ab 650 € projektmäßig, dazu Zoho-Lizenzen ab etwa 7 € pro Nutzer und Monat. Ein finales Angebot erhalten Sie nach dem Erstgespräch.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Wie läuft die Zusammenarbeit ab?</summary>
            <div class="faq-answer">
              <p>Klar strukturiert: Erstgespräch, dann eine schriftliche Empfehlung mit klarem Preis und Umfang, dann die Umsetzung inklusive Einweisung Ihres Teams. Sie wissen jederzeit, was als Nächstes passiert. Nach dem Projekt bin ich für Rückfragen erreichbar.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Wo werden meine Daten gespeichert?</summary>
            <div class="faq-answer">
              <p>In der EU. Zoho betreibt Rechenzentren in Amsterdam und Dublin, und ich richte Kundenkonten standardmäßig mit EU-Hosting ein. Die Auftragsverarbeitung mit Zoho ist über dessen Datenschutzvereinbarung geregelt. Was für Ihren Fall relevant ist, klären wir im Erstgespräch.</p>
            </div>
          </details>
          <details class="faq-item">
            <summary>Wir arbeiten noch mit Excel und Outlook. Lohnt sich Zoho trotzdem?</summary>
            <div class="faq-answer">
              <p>Das klären wir im Erstgespräch. Wenn Ihre Abläufe mit Excel und Outlook sauber laufen, sage ich Ihnen das offen. Ein System wie Zoho Bigin wird interessant, sobald mehrere Personen an denselben Kundendaten arbeiten oder Kundenanfragen durchrutschen. Ob das bei Ihnen schon der Fall ist, prüfen wir gemeinsam, ehe Sie einen Euro ausgeben.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ===== Formular Section ==== */
  .kontakt-section {
    padding: 72px 0;
    border-top: 1px solid var(--line);
  }

  .kontakt-section-head {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .kontakt-section-head h2 {
    margin: 8px 0 14px;
  }

  .kontakt-intro {
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.65;
    max-width: 56ch;
    margin: 0;
  }

  /* ===== Info-Strip (3 Karten) ==== */
  .kontakt-info-strip {
    padding: 72px 0;
    border-top: 1px solid var(--line);
    background: var(--bg-alt);
  }

  .info-strip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .info-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s;
  }

  .info-card:hover {
    border-color: var(--green-bright);
  }

  .info-card--accent {
    background: var(--paper);
    border-color: var(--green-bright);
  }

  .info-card-title {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--green-deep);
    margin: 4px 0 4px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .info-card-text {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 8px;
  }

  /* Buttons in Karten */
  .info-card-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
  }

  .info-card-btn {
    width: 100%;
    justify-content: center;
  }

  /* Liste in Wann & Wo */
  .info-card-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .info-card-list li {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .info-card-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-bright);
  }

  .info-card-value {
    font-size: 15px;
    color: var(--ink);
    font-weight: 500;
  }

  /* ===== FAQ ==== */
  .kontakt-faq {
    padding: 72px 0;
    border-top: 1px solid var(--line);
  }

  .section-head {
    margin-bottom: 48px;
  }

  .section-head h2 {
    margin-top: 8px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }

  .faq-item {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 24px 28px;
    transition: border-color 0.15s;
  }

  .faq-item:hover {
    border-color: var(--green-bright);
  }

  .faq-item[open] {
    border-color: var(--green-bright);
  }

  .faq-item summary {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--green-deep);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    letter-spacing: -0.01em;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--green-bright);
    flex-shrink: 0;
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: "\2212";
  }

  .faq-item[open] summary {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .faq-answer {
    padding-top: 2px;
  }

  .faq-answer p {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.65;
    margin: 0;
  }

  /* ===== Responsive ==== */
  @media (max-width: 880px) {
    .info-strip-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .kontakt-section-head {
      margin-bottom: 36px;
    }
  }

  @media (max-width: 560px) {
    .info-card {
      padding: 28px 24px;
    }

    .faq-item {
      padding: 20px 24px;
    }

    .faq-item summary {
      font-size: 16px;
    }
  }
</style>
