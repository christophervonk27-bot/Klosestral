---
const baseUrl = import.meta.env.BASE_URL;
---

<footer>
  <div class="wrap">
    <div class="foot-row">
      <a href={`${baseUrl}`} class="brand" aria-label="kloseup – Startseite">
        <img src={`${baseUrl}logos/Logo_mit_Text.svg`} alt="kloseup" class="logo-img" />
      </a>
      <div class="meta">© 2026 Christopher Klose · kloseup.eu</div>
    </div>
    <div class="foot-links">
      <a href={`${baseUrl}impressum`}>Impressum</a>
      <a href={`${baseUrl}datenschutz`}>Datenschutz</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg);
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  .foot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .logo-img {
    height: 28px;
  }

  .meta {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .foot-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .foot-links a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--green-bright);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .foot-links a:hover {
    color: var(--green-deep);
  }

  @media (max-width: 560px) {
    .foot-row {
      flex-direction: column;
      gap: 12px;
    }

    .meta {
      text-align: center;
    }
  }
</style>
