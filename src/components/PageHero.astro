---
interface Props {
  eyebrow: string;
  titel: string;
  titelEm?: string;
  lede: string;
  kompakt?: boolean;
}

const { eyebrow, titel, titelEm, lede, kompakt = false } = Astro.props;

const hasAside = Astro.slots.has('aside');
const hasDefault = Astro.slots.has('default');
---

<section class={kompakt ? 'hero hero--kompakt' : 'hero'}>
  <div class="wrap" class:list={[
    hasAside ? 'hero-grid' : '',
  ]}>
    <div class="hero-content">
      <p class="eyebrow">{eyebrow}</p>
      <h1>
        {titel}
        {titelEm && <em>{titelEm}</em>}
      </h1>
      <p class="lede">{lede}</p>
      {hasDefault && <slot />}
    </div>
    {hasAside && <div class="hero-aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 88px;
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 40px;
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(34px, 4.8vw, 54px);
    font-weight: 700;
    color: var(--green-deep);
    margin: 22px 0 26px;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .hero h1 em {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: var(--green-bright);
  }

  .hero .lede {
    font-size: 19px;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 34px;
    line-height: 1.6;
  }

  .hero-aside {
    justify-self: center;
  }

  /* Kompakt-Variante: breite Textspalte, schmale Aside-Spalte (derzeit /ueber-mich) */
  .hero--kompakt { padding: 96px 0 72px; }
  .hero--kompakt .hero-grid { grid-template-columns: 1fr auto; }

  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-aside {
      margin-top: 24px;
    }
  }
</style>
