---
const baseUrl = import.meta.env.BASE_URL;

interface Props {
  variant?: 'header' | 'card' | 'small';
  showLink?: boolean;
}

const { variant = 'header', showLink = true } = Astro.props;

const sizeClasses: Record<string, string> = {
  header: 'height: 32px;',
  card: 'height: clamp(26.4px, 2.86vw, 37.4px);',
  small: 'height: clamp(26.4px, 2.86vw, 37.4px); width: auto; max-width: 100%;'
};

const sizeStyle = sizeClasses[variant] || sizeClasses.header;
---

{showLink ? (
  <a href={`${baseUrl}`} class="brand" aria-label="kloseup – Startseite">
    <img src={`${baseUrl}logos/Logo_mit_Text.svg`} alt="kloseup" class="logo-img" style={sizeStyle} />
  </a>
) : (
  <img src={`${baseUrl}logos/Logo_mit_Text.svg`} alt="kloseup" class="logo-img" style={sizeStyle} />
)}
